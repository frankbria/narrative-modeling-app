# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .venv/
__pycache__/
*.pyc
.env

.venv/
apps/.venv/
apps/backend/.venv/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
!terraform.tfvars.example

# Infrastructure secrets
infrastructure/secrets/
*.pem
*.key

# Large binary files
scripts/awscliv2.zip

# Agent / audit / benchmark scratch output (issue #288 — keep these out of git)
.apm/
.benchmarks/
coverage_summary.txt
test.csv
*.log
!**/npm-debug.log*

# Serena MCP server data
.serena/

# Claude Code local settings
.claude/settings.local.json

# Claude Flow
memory/claude-flow-data.json
.claude/logs/
.swarm/
.claude-flow/

# Local demo / scratch artifacts (per-issue demo docs, screenshots, scratch
# notes). These are generated locally and can embed environment-specific data
# such as presigned S3 URLs with credentials, so they are not committed by
# default. Scoped to the repo-root tasks/ dir only (apps/backend/tasks/ is
# unaffected). Already-tracked files are re-included below; force an
# intentional commit of a new artifact with `git add -f`.
/tasks/*
!/tasks/issue-76-demo.md
!/tasks/lessons.md
!/tasks/todo.md
apps/backend/mypy_out.txt
