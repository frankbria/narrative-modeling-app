# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .venv/
__pycache__/
*.pyc
.env

.venv/
apps/.venv/
apps/backend/.venv/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
!terraform.tfvars.example

# Infrastructure secrets
infrastructure/secrets/
*.pem
*.key

# Large binary files
scripts/awscliv2.zip

# Agent / audit / benchmark scratch output (issue #288 — keep these out of git)
.apm/
.benchmarks/
coverage_summary.txt
test.csv
*.log
!**/npm-debug.log*

# Serena MCP server data
.serena/

# Claude Code local settings
.claude/settings.local.json

# Claude Code logs
.claude/logs/

# Local plans, demo docs and scratch notes. They can embed environment-specific
# data such as presigned S3 URLs with credentials, so none of it is committed.
/tasks/
apps/backend/tasks/
# Screenshots dropped at the repo root by a demo or an e2e run (#532).
/*.png
/*.jpg
/*.gif
/*.webm
apps/backend/mypy_out.txt

# Local scratch scripts (a broad `git add apps/backend` swept one into two PRs)
apps/backend/_demo_*.py
/_demo_*.py
