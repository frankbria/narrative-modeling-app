{
  "enabledPlugins": {
    "quartermaster@eigenwise-toolshed": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-push-to-main.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/install-git-hooks.sh >/dev/null"
          }
        ]
      }
    ]
  }
}
