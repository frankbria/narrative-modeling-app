# Production environment template — copy to `.env` next to your production
# compose file and fill in real values. Every variable name here matches what
# docker-compose.staging.yml consumes (the deploy contract), so the two do not
# drift (#491). NextAuth is the auth system — there is no Clerk and no JWT_SECRET.
#
# Legend:  [required] must be set or the deploy/app is broken.
#          [optional] safe to leave blank; a sensible default applies.

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=production                 # [required] enables prod hardening (SKIP_AUTH is refused unless dev/test, #149)
APP_VERSION=1.0.0                      # [optional] surfaced by /health and logs
# Behind an nginx/ALB reverse proxy the limiter must trust X-Real-IP, or every
# anonymous request shares the proxy's IP as one rate-limit bucket (#483).
RATE_LIMIT_TRUST_PROXY=true            # [required behind a proxy]

# ─── Database (MongoDB) — same values for backend AND frontend ───────────────
# MONGODB_URI is bare (no database path). The db name comes from MONGODB_DB;
# omitting it sends NextAuth users/accounts to a db literally named `test` (#545).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.example.mongodb.net/   # [required] fill in real creds
MONGODB_DB=narrative_modeling                              # [required] must match on both services

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong        # [required] compose builds REDIS_URL from this

# ─── AWS / S3 ────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=<your-access-key-id>              # [required]
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>              # [required]
AWS_DEFAULT_REGION=us-east-1           # [required] compose also sets AWS_REGION from this
# The bucket. Compose mirrors this single value into AWS_S3_BUCKET / AWS_BUCKET_NAME
# / S3_BUCKET so the backend's resolver (resolve_configured_bucket) can't drift.
S3_BUCKET_NAME=your-prod-bucket        # [required]

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# The app degrades to rule-based fallbacks without a key, but AI features are off.
OPENAI_API_KEY=<your-openai-api-key>                  # [optional but expected in prod]
# OPENAI_REQUEST_TIMEOUT=30            # [optional] per-request timeout (s); clamped below the worker timeout (#501)

# ─── Backend security ────────────────────────────────────────────────────────
# Backend CORS allowlist (config.py BACKEND_CORS_ORIGINS). MUST be explicit
# origins — the backend refuses '*' in prod. NOT the same as the frontend's
# ALLOWED_ORIGINS below (the old ALLOWED_ORIGINS name was read by nothing here).
BACKEND_CORS_ORIGINS=https://app.example.com   # [required] comma-separated

# ─── Auth (NextAuth v5) — shared secret + OAuth providers ────────────────────
# The frontend signs the API JWT with NEXTAUTH_SECRET and the backend verifies
# it with the SAME value — they must match. A missing value only logs and starts
# anyway, with artifact signing silently degraded, so set it (#266/audit).
NEXTAUTH_SECRET=<32+ byte random string, e.g. openssl rand -hex 32>       # [required] identical on backend and frontend
# ARTIFACT_SIGNING_KEY=                 # [optional] HMAC key for model artifacts; falls back to NEXTAUTH_SECRET
NEXTAUTH_URL=https://app.example.com   # [required] the site's public URL
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com   # [required for Google login]
GOOGLE_CLIENT_SECRET=<your-google-client-secret>               # [required for Google login]
GITHUB_ID=<your-github-oauth-app-id>                          # [required for GitHub login]
GITHUB_SECRET=<your-github-oauth-secret>                      # [required for GitHub login]

# ─── Invite-only beta gate (#261) ────────────────────────────────────────────
# Comma-separated invitee emails. EMPTY DISABLES THE GATE — leaving the beta open
# to any Google/GitHub account. The frontend signIn callback is the primary gate;
# the backend mirrors it. Required for both services.
INVITE_ALLOWLIST=alice@example.com,bob@example.com   # [required]
NEXT_PUBLIC_INVITE_REQUEST_URL=        # [optional] where rejected users request access; defaults to a mailto

# ─── Admin allowlist (#477) — frontend only ──────────────────────────────────
# Only these emails reach /admin (middleware.ts). Fails closed: unset ⇒ nobody
# is admin. There is no backend admin mirror yet.
ADMIN_EMAILS=                          # [optional]

# ─── Frontend ────────────────────────────────────────────────────────────────
# MUST include the /api/v1 prefix and is baked in at build time (a build arg) AND
# read at runtime. Append only resource paths to it; never re-add /api or /api/v1.
NEXT_PUBLIC_API_URL=https://app.example.com/api/v1   # [required]
# CORS allowlist for the Next.js page middleware (middleware.ts). Empty ⇒ no
# cross-origin Origin is echoed (same-origin needs none).
ALLOWED_ORIGINS=                       # [optional]

# ─── Billing (Stripe, #365/#367/#457) ────────────────────────────────────────
# Provision ALL FOUR together or none. A secret key with no webhook secret takes
# money and entitles nobody — worse than no Stripe at all. Point the Stripe
# dashboard endpoint at https://<host>/webhooks/stripe/webhook (OUTSIDE /api/v1,
# #456). Unset ⇒ billing is inert: /billing/checkout 503s, webhooks are rejected,
# and the app runs on FREE limits (a supported configuration, ADR-002).
STRIPE_SECRET_KEY=                     # [optional; required to take payments]
STRIPE_WEBHOOK_SECRET=                 # [optional; required to take payments]
STRIPE_PRICE_PRO=                      # [optional; required to take payments]
STRIPE_PRICE_ENTERPRISE=               # [optional; required to take payments]
#
# NOTE on PLAN_* per-tier limits: there are deliberately NO PLAN_* variables here.
# app/billing/plans.py is the single source of the per-tier ceilings and applies
# to every environment; passing PLAN_* through deployment would add ways for this
# host to silently disagree with the code (#457 AC4 / #474). Change limits in
# plans.py, not via env.

# ─── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=                            # [optional] error tracking; unset ⇒ off
SENTRY_TRACES_SAMPLE_RATE=0.1          # [optional]
