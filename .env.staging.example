# ═══════════════════════════════════════════════════════════════
# SheetPredict - STAGING ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
#
# Copy to .env.staging in the deploy directory on the staging box
# (/opt/narrative-modeling-app/staging/.env.staging) and replace every
# placeholder. deploy.yml runs compose with `--env-file .env.staging`.
# Never commit the filled-in file.
#
# docker-compose.staging.yml is the contract: a variable reaches a container
# only if compose lists it, and the deploy preflight
# (scripts/deploy/preflight_staging_env.sh) refuses to deploy while any
# variable compose marks required is missing.
#
# Set by compose itself, not here: ENVIRONMENT, LOG_LEVEL/LOG_FORMAT,
# RATE_LIMIT_TRUST_PROXY=true (nginx sets X-Real-IP), AUTH_TRUST_HOST=true,
# PUBLIC_API_URL (copied from NEXT_PUBLIC_API_URL), and the bucket/region
# aliases fanned out from S3_BUCKET_NAME / AWS_DEFAULT_REGION.
#
# Secrets: `openssl rand -hex 32` (hex is URL-safe, which REDIS_PASSWORD needs).
# ═══════════════════════════════════════════════════════════════

# ─── Database (MongoDB Atlas) — shared by backend and frontend ──────────────
# The URI is BARE (no /dbname path); the database name is MONGODB_DB. Both
# services get both values. A bare URI without MONGODB_DB silently uses a
# database named `test` (#545), and the two services refuse to start if they
# disagree (#551).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=narrative_modeling-staging

# ─── Redis ──────────────────────────────────────────────────────────────────
# Do NOT set REDIS_URL: compose builds redis://:PASSWORD@redis:6379/0 from this,
# so the password must be URL-safe (hex, not base64).
REDIS_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ─── AWS S3 ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY
# Compose maps this to both AWS_DEFAULT_REGION and AWS_REGION (#257).
AWS_DEFAULT_REGION=us-east-1
# The one bucket. Compose fans it out to every name the backend reads
# (AWS_BUCKET_NAME, AWS_S3_BUCKET, S3_BUCKET) so they cannot drift.
S3_BUCKET_NAME=narrative-staging-uploads

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Without a key the AI features fall back to rule-based output; nothing breaks.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# ─── Public URLs and CORS ───────────────────────────────────────────────────
# The API as the browser reaches it. MUST include /api/v1; it is baked into the
# frontend at build time and is also the backend's PUBLIC_API_URL (#915).
NEXT_PUBLIC_API_URL=https://staging.example.com/api/v1
# The site's public URL, for NextAuth.
NEXTAUTH_URL=https://staging.example.com
# Hostname the nginx config is rendered for (scripts/deploy/apply_nginx_conf.sh).
# Unset means deploys never touch nginx. Its certificate must exist first: see
# docs/ops/STAGING_DEPLOYMENT_GUIDE.md, Step 7.
NGINX_SERVER_NAME=staging.example.com
# Backend CORS allowlist (comma-separated or a JSON array). MUST be explicit
# origins: the backend refuses '*' in production-like environments.
BACKEND_CORS_ORIGINS=https://staging.example.com
# Frontend page-middleware CORS allowlist (comma-separated). Empty: no
# cross-origin Origin is echoed; same-origin needs no entry.
ALLOWED_ORIGINS=

# ─── Auth (NextAuth v5) ─────────────────────────────────────────────────────
# The frontend signs the API token with this and the backend verifies with it,
# so both services get the same value. It is also the fallback HMAC key for
# model artifacts: read docs/ops/ARTIFACT_INTEGRITY.md before rotating it.
NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GITHUB_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

# ─── Signup and admin access (#261, #477, #768, #780) ───────────────────────
# Who may sign up: `invite` (only INVITE_ALLOWLIST) or `open` (any Google/GitHub
# account). REQUIRED: compose refuses to start without it and the preflight
# refuses any other value. Read by both services.
SIGNUP_MODE=invite
# Comma-separated invitee emails. REQUIRED while SIGNUP_MODE is `invite` (the
# preflight fails without it); invite mode with an empty list admits nobody.
# To add an invitee, append the email and redeploy.
INVITE_ALLOWLIST=alice@example.com,bob@example.com
# Where rejected users request access (mailto: or a form URL). Unset: a mailto.
NEXT_PUBLIC_INVITE_REQUEST_URL=
# Comma-separated emails that may open /admin and GET /metrics. Fails closed:
# unset means nobody is admin and both answer 404.
ADMIN_EMAILS=

# ─── Cost and abuse backstops (#768) ────────────────────────────────────────
# Blank uses the ADR-003 defaults: 500 model calls per UTC day across all
# tenants, and the health probe reports unhealthy above 100 signups in 24h.
AI_CALLS_DAILY_CEILING=
SIGNUP_ALERT_THRESHOLD_24H=

# ─── Billing (Stripe, #365, #367, #457) ─────────────────────────────────────
# Optional to compose: without them every tenant stays on FREE limits and
# billing is INERT and SILENT — POST /api/v1/billing/checkout answers 503, the
# webhook rejects every event, GET /api/v1/billing/status reports
# "configured": false. The backend names any unset variable in its startup log
# (grep it for "Billing:").
#
# Provision all four together. A secret key without the webhook secret is the
# worst state: checkout charges the customer, and the event that would entitle
# them is thrown away. Test-mode keys (sk_test_...) on staging.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
# Signing secret of the webhook endpoint (Stripe dashboard → Developers →
# Webhooks), URL https://YOUR_HOST/webhooks/stripe/webhook — NOT under /api/v1,
# so the rate limiter cannot 429 Stripe's IP pool (#367, #456). Subscribe it to
# every event in HANDLED_EVENTS (app/api/routes/billing_webhook.py):
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.payment_failed
# An event left off this list is never delivered, and nothing reports it.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET
# `price_...` ids, NOT `prod_...` ids. The webhook maps a subscription's price
# back to a tier through these; a wrong id entitles a paying customer to nothing.
STRIPE_PRICE_PRO=price_REPLACE_WITH_PRO_PRICE_ID
STRIPE_PRICE_ENTERPRISE=price_REPLACE_WITH_ENTERPRISE_PRICE_ID
#
# Deliberately not listed:
# - STRIPE_PUBLISHABLE_KEY: Checkout is hosted, so nothing in the browser reads it.
# - PLAN_* limit overrides (#457 AC4, #474): app/billing/plans.py is the single
#   source of per-tier limits for every environment. Change them there (with
#   ADR-003 and lib/billing/plans.json), never per box.

# ─── Observability (#273, #769) ─────────────────────────────────────────────
# Sentry, errors and APM. Empty disables it. The frontend uses it too, baked
# into the browser bundle at build time, so a new value needs a rebuild.
SENTRY_DSN=
# Fraction of requests traced (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Tags logs and the Sentry release.
APP_VERSION=staging
