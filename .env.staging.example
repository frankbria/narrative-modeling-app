# ═══════════════════════════════════════════════════════════════
# Narrative Modeling App - STAGING ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env.staging on the staging server
# 2. Replace all placeholder values with actual secrets
# 3. Never commit .env.staging to version control
# 4. Store actual secrets in GitHub Secrets for deployment automation
#
# Location on staging server: /opt/narrative-modeling-app/staging/.env.staging
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# DATABASE CREDENTIALS
# ═══════════════════════════════════════════════════════════════

# MongoDB root password (for admin user)
MONGODB_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32_CHARS

# MongoDB application user password
MONGODB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32_CHARS

# ═══════════════════════════════════════════════════════════════
# CACHE CREDENTIALS
# ═══════════════════════════════════════════════════════════════

# Redis password
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32_CHARS

# ═══════════════════════════════════════════════════════════════
# AWS S3 STORAGE
# ═══════════════════════════════════════════════════════════════

# AWS credentials for S3 storage
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=narrative-staging-uploads

# ═══════════════════════════════════════════════════════════════
# AI SERVICES
# ═══════════════════════════════════════════════════════════════

# OpenAI API Key for AI features
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# ═══════════════════════════════════════════════════════════════
# BACKEND CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Backend secret key for JWT and encryption (generate with: openssl rand -hex 32)
BACKEND_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_64_CHARS

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://narrative.yourdomain.com,https://staging.yourdomain.com

# ═══════════════════════════════════════════════════════════════
# FRONTEND CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Public API URL (accessible from browser)
NEXT_PUBLIC_API_URL=https://narrative.yourdomain.com/api

# NextAuth configuration
NEXTAUTH_URL=https://narrative.yourdomain.com
NEXTAUTH_SECRET=REPLACE_WITH_NEXTAUTH_SECRET_64_CHARS

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION PROVIDERS
# ═══════════════════════════════════════════════════════════════

# Google OAuth
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# GitHub OAuth
GITHUB_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

# ═══════════════════════════════════════════════════════════════
# SECURITY NOTES
# ═══════════════════════════════════════════════════════════════
#
# Password Generation Commands:
#   openssl rand -base64 32  # Generate 32-character password
#   openssl rand -hex 32     # Generate 64-character hex secret
#
# Required Secrets in GitHub:
#   - STAGING_MONGODB_ROOT_PASSWORD
#   - STAGING_MONGODB_PASSWORD
#   - STAGING_REDIS_PASSWORD
#   - STAGING_AWS_ACCESS_KEY_ID
#   - STAGING_AWS_SECRET_ACCESS_KEY
#   - STAGING_OPENAI_API_KEY
#   - STAGING_BACKEND_SECRET_KEY
#   - STAGING_NEXTAUTH_SECRET
#   - STAGING_GOOGLE_CLIENT_ID
#   - STAGING_GOOGLE_CLIENT_SECRET
#   - STAGING_GITHUB_ID
#   - STAGING_GITHUB_SECRET
#
# ═══════════════════════════════════════════════════════════════
