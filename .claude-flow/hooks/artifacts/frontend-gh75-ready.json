  "required_backend_apis": {
    "endpoints": [
      {
        "method": "POST",
        "path": "/api/v1/ml/datasets/{dataset_id}/detect-problem-type",
        "request_body": {
          "target_column": "string"
        },
        "response": {
          "problem_type": "BINARY_CLASSIFICATION | MULTICLASS_CLASSIFICATION | REGRESSION | TIME_SERIES_FORECASTING | TIME_SERIES_CLASSIFICATION",
          "confidence": "number (0-1)",
          "reasoning": "string",
          "metadata": "object"
        }
      },
      {
        "method": "POST",
        "path": "/api/v1/ml/datasets/{dataset_id}/recommend-algorithms",
        "request_body": {
          "problem_type": "string",
          "training_mode": "QUICK | BALANCED | COMPREHENSIVE",
          "optimize_for": "ACCURACY | SPEED | INTERPRETABILITY"
        },
        "response": {
          "recommendations": [
            {
              "algorithm": "string",
              "priority": "number (1-10)",
              "expected_performance": "string",
              "training_time_estimate": "string",
              "interpretability_score": "number (0-1)",
              "explanation": "string (AI-generated)",
              "pros": ["string"],
              "cons": ["string"]
            }
          ]
        }
      },
      {
        "method": "POST",
        "path": "/api/v1/ml/datasets/{dataset_id}/train-automl",
        "request_body": {
          "target_column": "string",
          "problem_type": "string",
          "selected_algorithms": ["string"],
          "training_mode": "QUICK | BALANCED | COMPREHENSIVE",
          "optimize_for": "ACCURACY | SPEED | INTERPRETABILITY",
          "class_balancing": {
            "enabled": "boolean",
            "method": "SMOTE | RANDOM_OVERSAMPLE | RANDOM_UNDERSAMPLE | SMOTE_TOMEK"
          },
          "advanced_config": {
            "cv_folds": "number",
            "test_size": "number",
            "random_seed": "number"
          }
        },
        "response": {
          "job_id": "string",
          "status": "QUEUED | RUNNING",
          "message": "string"
        }
      },
      {
        "method": "GET",
        "path": "/api/v1/ml/training-jobs/{job_id}/status",
        "response": {
          "job_id": "string",
          "status": "QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED",
          "progress": {
            "current_algorithm": "string",
            "completed_algorithms": ["string"],
            "total_algorithms": "number",
            "current_cv_fold": "number",
            "total_cv_folds": "number",
            "estimated_time_remaining": "string"
          }
        }
      },
      {
        "method": "GET",
        "path": "/api/v1/ml/training-jobs/{job_id}/results",
        "response": {
          "job_id": "string",
          "status": "COMPLETED",
          "best_model_id": "string",
          "trained_models": [
            {
              "model_id": "string",
              "algorithm": "string",
              "cv_score": "number",
              "test_score": "number",
              "training_time": "number",
              "model_size": "number",
              "interpretability_score": "number",
              "metrics": "object"
            }
          ],
          "comparison": {
            "ranking": ["string (model_ids)"],
            "comparison_table": "object",
            "performance_summary": "string",
            "recommendation": "string (AI-generated explanation)"
          }
        }
      },
      {
        "method": "WebSocket",
        "path": "/ws/training/{job_id}",
        "authentication": "JWT token in connection params",
        "message_format": {
          "type": "PROGRESS | LOG | ERROR | COMPLETE",
          "timestamp": "string",
          "data": {
            "algorithm": "string (optional)",
            "cv_fold": "number (optional)",
            "message": "string",
            "progress_percent": "number (0-100)"
          }
        }
      }
    ]
