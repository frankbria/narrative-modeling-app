  "test_organization": {
    "markers": {
      "unit": "Tests that don't require external services (MongoDB, Redis, AWS)",
      "integration": "Tests that require external services and database connections"
    },
    "directory_structure": {
      "test_utils": "Utility function unit tests",
      "test_middleware": "FastAPI middleware tests",
      "test_security": "Security-related tests (PII detection, upload validation)",
      "test_processing": "Data processing unit tests",
      "test_model_training": "ML model training unit tests"
    }
  },
  "test_commands": {
    "backend_all_tests": {
      "description": "Run all backend tests (requires MongoDB)",
      "command": "cd apps/backend && uv run pytest",
      "requirements": ["MongoDB running on localhost:27017"],
      "expected_result": "214/214 passing"
    },
    "backend_unit_tests": {
      "description": "Run only unit tests (no database required)",
      "command": "cd apps/backend && uv run pytest tests/test_security/ tests/test_processing/ tests/test_utils/ tests/test_model_training/test_problem_detector.py tests/test_model_training/test_feature_engineer.py -v",
      "requirements": [],
      "expected_result": "203/203 passing"
    },
    "backend_integration_tests": {
      "description": "Run only integration tests",
      "command": "cd apps/backend && uv run pytest -m integration -v",
      "requirements": ["MongoDB running on localhost:27017"],
      "expected_result": "11/11 passing"
    },
    "frontend_unit_tests": {
      "description": "Run Jest unit tests for components",
      "command": "cd apps/frontend && npm test",
      "requirements": [],
      "coverage_requirement": 80
    },
    "frontend_e2e_tests": {
      "description": "Run Playwright end-to-end tests",
      "command": "cd apps/frontend && npm run test:e2e",
      "requirements": [
        "Frontend running (npm run dev)",
        "Backend running (uv run uvicorn app.main:app)",
        "MongoDB running"
      ]
    },
    "mcp_tests": {
      "description": "Run MCP server tests",
      "command": "cd apps/mcp && uv run pytest",
      "requirements": []
    }
  },
  "test_patterns": {
    "lazy_loading": {
      "description": "Use lazy imports in conftest.py to avoid full app initialization for unit tests",
      "example": "tests/conftest.py uses @pytest.fixture(scope='function') with lazy import of app.main",
      "benefit": "Unit tests don't trigger MongoDB connection"
    },
    "database_mocking": {
      "description": "DO NOT mock database for integration tests - use real MongoDB",
      "rationale": "TDD philosophy: No mocking, use real services",
      "setup": "Ensure MongoDB running before integration tests"
    },
    "s3_mocking": {
      "description": "Mock boto3 S3 client for unit tests",
      "pattern": "Use @patch('app.utils.s3.boto3.client')",
      "example": "tests/test_utils/test_s3.py"
    },
    "fastapi_testing": {
      "description": "Use TestClient for API route testing",
      "pattern": "from fastapi.testclient import TestClient; client = TestClient(app)",
      "example": "tests/test_middleware/test_api_version.py"
    }
  },
  "quality_gates": {
    "pre_commit": {
      "description": "Checks before committing code",
      "checks": [
        {
          "name": "All tests pass",
          "requirement": "100% pass rate",
          "command": "cd apps/backend && uv run pytest"
        },
        {
          "name": "Test coverage",
          "requirement": ">85% coverage",
          "command": "cd apps/backend && uv run pytest --cov=app --cov-report=term"
        },
        {
          "name": "Linting (backend)",
          "requirement": "No errors",
          "command": "cd apps/backend && uv run ruff check ."
        },
        {
          "name": "Type checking (backend)",
          "requirement": "No type errors",
          "command": "cd apps/backend && uv run mypy app/"
        },
        {
          "name": "Linting (frontend)",
          "requirement": "No errors",
          "command": "cd apps/frontend && npm run lint"
        },
        {
          "name": "Type checking (frontend)",
          "requirement": "No type errors",
          "command": "cd apps/frontend && npm run type-check"
        },
        {
          "name": "No placeholder markers",
          "requirement": "Zero occurrences",
          "patterns": ["TODO", "FIXME", "NotImplemented", "NotImplementedError"]
        }
      ]
    },
    "pre_pr": {
      "description": "Additional checks before creating pull request",
      "checks": [
        {
          "name": "All pre_commit checks",
          "requirement": "Must pass"
        },
        {
          "name": "E2E tests",
          "requirement": "100% pass rate",
          "command": "cd apps/frontend && npm run test:e2e"
        },
        {
          "name": "Security scan",
          "requirement": "No OWASP vulnerabilities",
          "patterns": [
            "SQL injection",
            "XSS vulnerabilities",
            "Hardcoded credentials",
            "Insecure cryptography"
          ]
        },
        {
          "name": "Documentation updated",
          "requirement": "Relevant docs reflect changes",
          "files": [
            "CLAUDE.md",
            "README.md",
            "apps/backend/docs/*.md"
          ]
        }
      ]
    }
  },
