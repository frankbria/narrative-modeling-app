  "common_issues": {
    "mongodb_connection_failed": {
      "symptom": "MongoServerError or connection timeout",
      "fix": "Start MongoDB: mongod --dbpath /path/to/data",
      "verify": "mongosh --eval 'db.runCommand({ ping: 1 })'"
    },
    "import_errors": {
      "symptom": "ModuleNotFoundError",
      "fix": "Ensure virtual environment activated and dependencies installed: uv sync"
    },
    "hanging_tests": {
      "symptom": "Tests hang during import",
      "fix": "Check for eager imports in conftest.py, use lazy loading pattern"
    }
  }
