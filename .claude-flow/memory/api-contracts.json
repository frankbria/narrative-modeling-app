{
  "version": "1.0",
  "last_updated": "2025-12-26T12:00:00Z",
  "base_url": "/api/v1",
  "authentication": {
    "type": "NextAuth session token",
    "header": "Authorization: Bearer <token>",
    "optional_bypass": "SKIP_AUTH=true in development"
  },
  "endpoint_groups": {
    "datasets": {
      "base_path": "/api/v1/datasets",
      "routes_file": "apps/backend/app/api/routes/datasets.py",
      "key_endpoints": [
        {
          "path": "/upload",
          "method": "POST",
          "description": "Upload a dataset file (CSV, XLSX, JSON)",
          "authentication": "required",
          "request": {
            "content_type": "multipart/form-data",
            "max_size_mb": 100
          },
          "response": {
            "201": "Dataset metadata with ID",
            "400": "Invalid file format",
            "413": "File too large"
          }
        },
        {
          "path": "/{id}",
          "method": "GET",
          "description": "Retrieve dataset metadata",
          "authentication": "required"
        }
      ]
    },
    "models": {
      "base_path": "/api/v1/models",
      "routes_file": "apps/backend/app/api/routes/models.py",
      "key_endpoints": [
        {
          "path": "/train",
          "method": "POST",
          "description": "Train a new ML model on a dataset",
          "authentication": "required"
        }
      ]
    },
    "model_training": {
      "base_path": "/api/v1/model_training",
      "routes_file": "apps/backend/app/api/routes/model_training.py",
      "key_endpoints": []
    },
    "data_processing": {
      "base_path": "/api/v1/data_processing",
      "routes_file": "apps/backend/app/api/routes/data_processing.py",
      "key_endpoints": [
        {
          "path": "/statistics",
          "method": "POST",
          "description": "Generate statistical summary of dataset"
        }
      ]
    },
    "visualizations": {
      "base_path": "/api/v1/visualizations",
      "routes_file": "apps/backend/app/api/routes/visualizations.py",
      "key_endpoints": []
    },
    "batch_prediction": {
      "base_path": "/api/v1/batch_prediction",
      "routes_file": "apps/backend/app/api/routes/batch_prediction.py",
      "key_endpoints": []
    },
    "ai_analysis": {
      "base_path": "/api/v1/ai_analysis",
      "routes_file": "apps/backend/app/api/routes/ai_analysis.py",
      "key_endpoints": []
    },
    "monitoring": {
      "base_path": "/api/v1/monitoring",
      "routes_file": "apps/backend/app/api/routes/monitoring.py",
      "key_endpoints": [
        {
          "path": "/health",
          "method": "GET",
          "description": "Health check endpoint",
          "authentication": "not_required"
        }
      ]
    },
    "ab_testing": {
      "base_path": "/api/v1/ab_testing",
      "routes_file": "apps/backend/app/api/routes/ab_testing.py",
      "key_endpoints": []
    }
  },
  "common_response_formats": {
    "success": {
      "status_code": 200,
      "body": {
        "success": true,
        "data": "..."
      }
    },
    "error": {
      "status_code": "4xx or 5xx",
      "body": {
        "detail": "Error message"
      }
    }
  },
  "notes": [
    "All endpoints use FastAPI automatic OpenAPI documentation",
    "Swagger UI available at /docs",
    "ReDoc available at /redoc",
    "CORS enabled for development",
    "Rate limiting not yet implemented"
  ]
}
