# Frontend (Next.js) environment — copy to .env.local and fill in.
# Never commit .env.local (it is gitignored).

# --- Backend API ---
# API base the app appends resource paths to (e.g. `${API_URL}/upload/secure`),
# so it MUST include the /api/v1 prefix — this matches the code's own fallback.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Version-less backend origin (used where callers add their own path prefix).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development

# --- Database (NextAuth adapter) ---
# lib/db.ts throws on startup without MONGODB_URI (except when CI=true).
# Keep the URI bare — no database in the path — and name the database in
# MONGODB_DB, matching the backend, which selects with `client[db_name]`.
# If MONGODB_DB is unset the adapter falls back to the URI's default database,
# which on a bare URI is the one literally named `test`.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=narrative-modeling

# --- Auth (NextAuth v5) ---
# Shared secret: also used to mint the HS256 JWT the backend verifies, so it
# MUST match the backend's expectation. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# OAuth providers (create apps in the Google/GitHub developer consoles)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# --- Access control (optional) ---
# Comma-separated allowlist of emails permitted to sign in (empty = open in dev).
INVITE_ALLOWLIST=
# Where to send users who are not on the allowlist.
NEXT_PUBLIC_INVITE_REQUEST_URL=
