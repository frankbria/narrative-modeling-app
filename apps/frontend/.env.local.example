# Frontend (Next.js) environment — copy to apps/frontend/.env.local for local
# development (gitignored). Deployed environments use the repo-root
# .env.staging.example / .env.production.example instead.

# ─── Environment ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENVIRONMENT=development

# ─── Database (MongoDB) — same values in both services ──────────────────────
# Keep the URI bare (no database in the path) and name the database in
# MONGODB_DB; without it the frontend's adapter lands on a database named `test`.
# With scripts/local-setup.sh's container (auth on), use instead:
#   mongodb://admin:localpassword@localhost:27017/?authSource=admin
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=narrative-modeling

# ─── Auth (NextAuth v5) — same values in both services ──────────────────────
# The frontend signs the API token with NEXTAUTH_SECRET and the backend verifies
# it, so the two files MUST hold the same value or every API call answers 401.
# Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-the-same-secret-in-both-env-files
NEXTAUTH_URL=http://localhost:3000

# OAuth providers (apps created in the Google / GitHub developer consoles).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ─── Signup and admin access (#768) — same values in both services ──────────
# SIGNUP_MODE: invite | open. Unset in production means invite (fails closed);
# unset in dev/test is open unless INVITE_ALLOWLIST is set.
SIGNUP_MODE=
# Comma-separated emails allowed to sign in when SIGNUP_MODE is invite. Invite
# mode with an empty list admits nobody.
INVITE_ALLOWLIST=
# Comma-separated emails that may open /admin and GET /metrics. Empty: nobody.
ADMIN_EMAILS=
# Where users who are not on the allowlist request access. Unset: a mailto.
NEXT_PUBLIC_INVITE_REQUEST_URL=

# ─── Observability — same value in both services ────────────────────────────
# Sentry error tracking. Empty disables it (the usual local setting).
SENTRY_DSN=
# Browser-side DSN, inlined at build time (a new value needs a rebuild).
NEXT_PUBLIC_SENTRY_DSN=

# ─── Backend API and CORS ───────────────────────────────────────────────────
# The base the app appends resource paths to, so it MUST include /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Comma-separated origins the page middleware echoes. Empty: same-origin only.
ALLOWED_ORIGINS=
