{
  "$defs": {
    "FeatureConfigRequest": {
      "additionalProperties": false,
      "description": "Caller-settable feature-engineering knobs (#500).\n\n``extra=\"forbid\"`` on these three models is the bound: a knob that is not\ndeclared here cannot reach the pipeline at all. Lower bounds live here;\nper-tier upper bounds live in ``plans.TrainingCeilings`` and are checked in\nthe route once the caller's tier is known.",
      "properties": {
        "create_interactions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Create Interactions"
        },
        "encode_categorical": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encode Categorical"
        },
        "encoding_method": {
          "anyOf": [
            {
              "enum": [
                "onehot",
                "label"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding Method"
        },
        "exclude_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude Columns"
        },
        "handle_missing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handle Missing"
        },
        "keep_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keep Columns"
        },
        "max_features": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Features"
        },
        "missing_strategy": {
          "anyOf": [
            {
              "enum": [
                "mean",
                "median",
                "most_frequent",
                "constant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Strategy"
        },
        "scale_features": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale Features"
        },
        "scaling_method": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "minmax",
                "robust"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scaling Method"
        },
        "select_features": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Select Features"
        }
      },
      "title": "FeatureConfigRequest",
      "type": "object"
    },
    "TrainingConfigRequest": {
      "additionalProperties": false,
      "description": "Caller-settable AutoML knobs (#500). See ``FeatureConfigRequest``.",
      "properties": {
        "cv_folds": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cv Folds"
        },
        "early_stop_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Early Stop Score"
        },
        "enable_tuning": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable Tuning"
        },
        "max_models": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Models"
        },
        "test_size": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Size"
        },
        "time_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Limit"
        },
        "training_mode": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Mode"
        },
        "tuning_config": {
          "anyOf": [
            {
              "$ref": "#/$defs/TuningConfigRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tuning_strategy": {
          "anyOf": [
            {
              "enum": [
                "grid",
                "random",
                "bayesian"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tuning Strategy"
        }
      },
      "title": "TrainingConfigRequest",
      "type": "object"
    },
    "TuningConfigRequest": {
      "additionalProperties": false,
      "description": "Caller-settable hyperparameter-tuning knobs (#500). See ``FeatureConfigRequest``.",
      "properties": {
        "cv_folds": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cv Folds"
        },
        "n_jobs": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Jobs"
        },
        "n_trials": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Trials"
        },
        "random_state": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Random State"
        },
        "scoring": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scoring"
        },
        "strategy": {
          "anyOf": [
            {
              "enum": [
                "grid",
                "random",
                "bayesian"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy"
        },
        "time_budget": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Budget"
        }
      },
      "title": "TuningConfigRequest",
      "type": "object"
    }
  },
  "description": "Request for training a model",
  "properties": {
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "feature_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeatureConfigRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "target_column": {
      "title": "Target Column",
      "type": "string"
    },
    "training_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrainingConfigRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "dataset_id",
    "target_column"
  ],
  "title": "TrainModelRequest",
  "type": "object"
}
