# MongoDB
# For local development: mongodb://localhost:27017/
# For production/staging: Use MongoDB Atlas connection string via environment variables
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=narrative-modeling

# CORS
# JSON array or comma-separated. Bracketed-unquoted is tolerated, but a plain
# comma-separated list is the least ambiguous form.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (shared by the cache service and the rate-limit middleware). Leave empty
# to run without Redis — the limiter then uses a process-local in-memory store.
REDIS_URL=redis://localhost:6379

# Rate limiting (issue #151)
RATE_LIMIT_ENABLED=true
# Default budget for session/IP-identified callers (requests per window).
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
# Window over which an API key's `rate_limit` field is counted (default 1h).
RATE_LIMIT_APIKEY_WINDOW_SECONDS=3600
# Trust the client IP from X-Forwarded-For. Enable ONLY behind a trusted proxy
# (e.g. nginx) that overwrites the header; otherwise it is spoofable.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# AWS S3 credentials
AWS_ACCESS_KEY_ID=aws-access-key-id-placeholder
AWS_SECRET_ACCESS_KEY=aws-secret-access-key-placeholder
AWS_REGION=us-east-1  # or your bucket's region
AWS_BUCKET_NAME=bucket-name-placeholder
# Optional: route S3 calls to S3-compatible storage (MinIO, LocalStack).
# Leave unset for real AWS. Example: http://localhost:9000
# AWS_ENDPOINT_URL=

# OpenAI API key
OPENAI_API_KEY=openai-api-key-placeholder
OPENAI_MODEL=gpt-4-turbo  # or your preferred OpenAI model

# Test DB
# For local development: mongodb://localhost:27017/
# For CI/CD: Set via environment variables to point to Atlas test database
TEST_MONGODB_URI=mongodb://localhost:27017/
TEST_MONGODB_DB=narrative-modeling-test

# Deployment environment: development | test | staging | production
# The backend refuses to start if SKIP_AUTH=true and this is not
# explicitly "development" or "test" (issue #149).
ENVIRONMENT=development

# Observability (issue #273)
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (default INFO — now honored)
LOG_LEVEL=INFO
# LOG_FORMAT: "json" for structured logs (recommended in prod), else "text"
LOG_FORMAT=text
# APP_VERSION tags logs and the Sentry release
APP_VERSION=1.0.0
# Sentry error tracking + APM. Leave SENTRY_DSN empty to disable (dev/CI/test).
SENTRY_DSN=
# Fraction of requests traced for APM (0.0–1.0). Keep low in prod.
SENTRY_TRACES_SAMPLE_RATE=0.0

# Next Auth credentials
NEXTAUTH_SECRET=next-auth-secret-placeholder
# Optional dedicated secret for HMAC-signing model artifacts (issue #266). If
# unset, artifact signing falls back to NEXTAUTH_SECRET. Set a distinct value to
# rotate artifact trust independently of auth. See docs/deployment/ARTIFACT_INTEGRITY.md
ARTIFACT_SIGNING_KEY=
AUTH_SECRET=auth-secret-placeholder
NEXTAUTH_URL=http://localhost:3000
# DEVELOPMENT ONLY — bypasses ALL authentication. Requires ENVIRONMENT to be
# explicitly development/test; startup fails hard otherwise. Never enable in
# staging/production. When enabled, bind the backend to localhost (127.0.0.1)
# only and never network-expose it: every request maps to "dev-user-default"
# and there is no auth, so any reachable caller has full access (issue #272).
SKIP_AUTH=true

# Invite-only beta gate (issue #261). Comma-separated allowlist of invitee
# emails; the backend rejects (403) any authenticated request whose token email
# is not listed — mirroring the NextAuth signIn allowlist (the primary gate).
# LEAVE EMPTY to disable the gate (dev/test). In staging/production set this to
# the same value the frontend uses. To add an invitee: append their email and
# restart. Example: INVITE_ALLOWLIST=alice@example.com,bob@example.com
INVITE_ALLOWLIST=
