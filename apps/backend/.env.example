# Backend (FastAPI) environment — copy to apps/backend/.env for local development.
# Deployed environments use the repo-root .env.staging.example /
# .env.production.example instead; never copy those values here.

# ─── Environment ────────────────────────────────────────────────────────────
# development | test | staging | production
ENVIRONMENT=development
# DEVELOPMENT ONLY — bypasses ALL authentication: every request maps to
# "dev-user-default". Refused at startup unless ENVIRONMENT is development or
# test (#149). Bind the backend to 127.0.0.1 while it is on (#272). Set it to
# false to exercise real NextAuth tokens from the frontend.
SKIP_AUTH=true

# ─── Database (MongoDB) — same values in both services ──────────────────────
# Keep the URI bare (no database in the path) and name the database in
# MONGODB_DB; without it the frontend's adapter lands on a database named `test`.
# With scripts/local-setup.sh's container (auth on), use instead:
#   mongodb://admin:localpassword@localhost:27017/?authSource=admin
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=narrative-modeling

# Test database, used by pytest (it never touches MONGODB_DB).
TEST_MONGODB_URI=mongodb://localhost:27017/
TEST_MONGODB_DB=narrative-modeling-test

# ─── Auth (NextAuth v5) — same values in both services ──────────────────────
# The frontend signs the API token with NEXTAUTH_SECRET and the backend verifies
# it, so the two files MUST hold the same value or every API call answers 401.
# Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-the-same-secret-in-both-env-files
NEXTAUTH_URL=http://localhost:3000

# Optional dedicated HMAC key for model artifacts (#266). Unset: falls back to
# NEXTAUTH_SECRET. See docs/ops/ARTIFACT_INTEGRITY.md before rotating either.
ARTIFACT_SIGNING_KEY=

# ─── Signup and admin access (#768) — same values in both services ──────────
# SIGNUP_MODE: invite | open. Unset in production means invite (fails closed);
# unset in dev/test is open unless INVITE_ALLOWLIST is set.
SIGNUP_MODE=
# Comma-separated emails allowed to sign in when SIGNUP_MODE is invite. Invite
# mode with an empty list admits nobody.
INVITE_ALLOWLIST=
# Comma-separated emails that may open /admin and GET /metrics. Empty: nobody.
ADMIN_EMAILS=

# ─── Observability — same value in both services ────────────────────────────
# Sentry error tracking. Empty disables it (the usual local setting).
SENTRY_DSN=

# Fraction of requests traced for APM (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE=0.0
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. LOG_FORMAT: json | text.
LOG_LEVEL=INFO
LOG_FORMAT=text
# Tags logs and the Sentry release.
APP_VERSION=1.0.0

# ─── CORS and public URL ────────────────────────────────────────────────────
# Comma-separated (or a JSON array) explicit origins.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# The API's public base URL (https://host/api/v1), used in deployment endpoints
# and generated SDKs. Empty: the request's own base, which is right locally.
PUBLIC_API_URL=

# ─── Redis ──────────────────────────────────────────────────────────────────
# Shared by the cache and the rate limiter. Empty: run without Redis (the
# limiter then uses a process-local store).
REDIS_URL=redis://localhost:6379

# ─── Rate limiting (#151) ───────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Budget for session/IP-identified callers, per window.
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
# Window over which an API key's `rate_limit` is counted.
RATE_LIMIT_APIKEY_WINDOW_SECONDS=3600
# Trust X-Real-IP. Only behind a proxy that sets it from $remote_addr (nginx).
RATE_LIMIT_TRUST_PROXY=false

# ─── S3 (LocalStack, never a deployed bucket — #878) ────────────────────────
# scripts/local-setup.sh creates this bucket; to make it by hand:
#   docker compose -f docker-compose.test.yml up -d localstack
#   docker compose -f docker-compose.test.yml exec localstack awslocal s3 mb s3://narrative-modeling-local
# LocalStack accepts any credentials. They must not start with "test-", which
# the backend reads as "no storage" (mock mode). Without AWS_ENDPOINT_URL the
# backend warns at startup that development is using a real bucket.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=localstack
AWS_REGION=us-east-1
AWS_BUCKET_NAME=narrative-modeling-local

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Optional: without a real key the AI features use their rule-based fallbacks.
OPENAI_API_KEY=openai-api-key-placeholder
# Default model; the ADR-003 plan limits are sized to hold even on gpt-4.
OPENAI_MODEL=gpt-4o-mini

# ─── Billing (Stripe, #365, #367, #457) ─────────────────────────────────────
# All optional. With none set the app runs on FREE limits and billing is inert
# and silent: /billing/checkout answers 503, every webhook is rejected, and
# /billing/status reports "configured": false. The startup log names any unset
# ones (grep "Billing:"). Provision the first three together: a secret key without
# the webhook secret charges customers and entitles nobody. The ENTERPRISE price is
# set only for a sales-led deal (ADR-003).
STRIPE_SECRET_KEY=
# Signing secret of the endpoint https://YOUR_HOST/webhooks/stripe/webhook
# (outside /api/v1 so the rate limiter cannot 429 Stripe, #367/#456).
STRIPE_WEBHOOK_SECRET=
# `price_...` ids, not `prod_...` ids; a stale id entitles a paying customer to nothing.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Deliberately not listed: STRIPE_PUBLISHABLE_KEY (Checkout is hosted; nothing
# reads it back) and the PLAN_* limit overrides (#457 AC4): app/billing/plans.py
# holds the per-tier limits for every environment.
